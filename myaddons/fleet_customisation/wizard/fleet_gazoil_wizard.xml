<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action du wizard -->
    <record id="action_gazoil_wizard" model="ir.actions.act_window">
        <field name="name">Imprimer par periode</field>
        <field name="res_model">fleet.gazoil.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Formulaire du wizard -->
    <record id="view_gazoil_wizard_form" model="ir.ui.view">
        <field name="name">fleet.gazoil.wizard.form</field>
        <field name="model">fleet.gazoil.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer le rapport par periode">
                <group>
                    <group>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                    </group>
                    <group>
                        <field name="employee_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" type="object"
                            string="Generer le PDF" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
