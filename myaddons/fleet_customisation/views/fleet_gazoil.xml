<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Action Fenetre -->
    <record id="action_fleet_gazoil" model="ir.actions.act_window">
        <field name="name">Consommation Gazoil</field>
        <field name="res_model">fleet.gazoil</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vue Liste -->
    <record id="view_fleet_gazoil_list" model="ir.ui.view">
        <field name="name">fleet.gazoil.tree</field>
        <field name="model">fleet.gazoil</field>
        <field name="arch" type="xml">
            <tree string="Consommations Gazoil">
                <header>
                    <button name="%(fleet_customisation.action_gazoil_wizard)d"
                            type="action"
                            string="Imprimer rapport per"
                            class="btn-primary"/>
                </header>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="vehicle_id"/>
                <field name="department_id" optional="hide"/>
                <field name="nombre_litres" sum="Total litres"/>
                <field name="ancien_kilometrage" optional="hide"/>
                <field name="kilometrage_actuel" optional="hide"/>
                <field name="consommation_moyenne"/>
                <field name="montant" sum="Total DA"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_fleet_gazoil_form" model="ir.ui.view">
        <field name="name">fleet.gazoil.form</field>
        <field name="model">fleet.gazoil</field>
        <field name="arch" type="xml">
            <form string="Consommation Gazoil">
                <header>
                    <button name="%(fleet_customisation.action_report_gazoil)d" type="action"
                            string="Imprimer rapport" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Conducteur">
                            <field name="employee_id" placeholder="Selectionner un conducteur..."/>
                            <field name="department_id"/>
                            <field name="telephone_chauffeur"/>
                            <field name="numero_permis"/>
                            <field name="date_expiration_permis"/>
                        </group>
                        <group string="Vehicule">
                            <field name="vehicle_id"/>
                            <field name="vehicle_license_plate"/>
                            <field name="vehicle_model_id"/>
                            <field name="vehicle_fuel_type"/>
                        </group>
                        <group string="Details de la saisie">
                            <field name="date"/>
                            <field name="montant"/>
                            <field name="nombre_litres"/>
                            <field name="ancien_kilometrage"/>
                            <field name="kilometrage_actuel"/>
                            <field name="consommation_moyenne"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu -->
    <menuitem
            id="menu_fleet_gazoil"
            name="Consommation Gazoil"
            action="action_fleet_gazoil"
            parent="fleet.menu_root"
            sequence="52"/>

</odoo>