<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Module Category -->
        <record id="module_category_central_beton" model="ir.module.category">
            <field name="name">Central Beton</field>
            <field name="description">Gestion de Centrale a Beton</field>
            <field name="sequence">100</field>
        </record>

        <!-- Group: User (Operators, drivers) -->
        <record id="group_central_beton_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_central_beton"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group: Chef de Centrale (Plant supervisor) -->
        <record id="group_central_beton_chef_centrale" model="res.groups">
            <field name="name">Chef de Centrale</field>
            <field name="category_id" ref="module_category_central_beton"/>
            <field name="implied_ids" eval="[(4, ref('group_central_beton_user'))]"/>
        </record>

        <!-- Group: Qualite (Lab/quality team) -->
        <record id="group_central_beton_qualite" model="res.groups">
            <field name="name">Qualite</field>
            <field name="category_id" ref="module_category_central_beton"/>
            <field name="implied_ids" eval="[(4, ref('group_central_beton_user'))]"/>
        </record>

        <!-- Group: Finance -->
        <record id="group_central_beton_finance" model="res.groups">
            <field name="name">Finance</field>
            <field name="category_id" ref="module_category_central_beton"/>
            <field name="implied_ids" eval="[(4, ref('group_central_beton_user'))]"/>
        </record>

        <!-- Group: Manager (Full access) -->
        <record id="group_central_beton_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_central_beton"/>
            <field name="implied_ids" eval="[(4, ref('group_central_beton_chef_centrale'))]"/>
        </record>

        <!-- Record Rules -->

        <!-- Users can see MRP productions -->
        <record id="rule_production_user" model="ir.rule">
            <field name="name">Production MRP: utilisateur voit sa centrale</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_central_beton_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers can delete MRP productions -->
        <record id="rule_production_manager" model="ir.rule">
            <field name="name">Production MRP: responsable acces complet</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_central_beton_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
