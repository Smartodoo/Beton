            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
            <field name="is_matiere_beton" eval="True"/>
            <field name="type_matiere_beton">ciment</field>
            <field name="emplacement_beton">silo</field>
