<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Maintenance Request Form -->
    <record id="view_maintenance_request_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.central.beton</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Details Intervention" name="details_intervention">
                    <group>
                        <group>
                            <field name="type_intervention"/>
                            <field name="priorite_beton"/>
                            <field name="centrale_id"/>
                            <field name="duree_arret"/>
                        </group>
                        <group>
                            <field name="cout_main_oeuvre"/>
                            <field name="prochaine_echeance"/>
                            <field name="cout_intervention"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="description_panne" placeholder="Description de la panne..."/>
                        </group>
                        <group>
                            <field name="action_realisee" placeholder="Actions realisees..."/>
                        </group>
                    </group>
                </page>
                <page string="Pieces de Rechange" name="pieces">
                    <field name="piece_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="quantite"/>
                            <field name="prix_unitaire"/>
                            <field name="cout_total"/>
                            <field name="notes"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action for Beton Maintenance Requests -->
    <record id="action_maintenance_request_beton" model="ir.actions.act_window">
        <field name="name">Interventions Maintenance</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">tree,form,pivot,graph,calendar</field>
        <field name="domain">[('centrale_id', '!=', False)]</field>
    </record>

</odoo>
