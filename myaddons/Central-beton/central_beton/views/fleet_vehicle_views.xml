<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Fleet Vehicle Form -->
    <record id="view_fleet_vehicle_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.central.beton</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_livraisons" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not is_camion_malaxeur">
                    <field name="livraison_count" widget="statinfo"
                           string="Livraisons"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='note']" position="before">
                <page string="Camion Malaxeur" name="malaxeur"
                      invisible="not is_camion_malaxeur">
                    <group>
                        <group>
                            <field name="capacite_m3"/>
                            <field name="etat_camion" widget="badge"
                                   decoration-success="etat_camion == 'disponible'"
                                   decoration-warning="etat_camion == 'en_livraison'"
                                   decoration-info="etat_camion == 'en_maintenance'"
                                   decoration-danger="etat_camion == 'hors_service'"/>
                            <field name="immatriculation"/>
                        </group>
                        <group>
                            <field name="centrale_id"/>
                            <field name="date_derniere_vidange"/>
                            <field name="km_derniere_vidange"/>
                            <field name="prochaine_vidange_km"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="before">
                <field name="is_camion_malaxeur"/>
            </xpath>
        </field>
    </record>

    <!-- Action for Camions Malaxeurs -->
    <record id="action_camion_malaxeur" model="ir.actions.act_window">
        <field name="name">Camions Malaxeurs</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_camion_malaxeur', '=', True)]</field>
        <field name="context">{'default_is_camion_malaxeur': True}</field>
    </record>

</odoo>
