<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_centrale_form" model="ir.ui.view">
        <field name="name">central.beton.centrale.form</field>
        <field name="model">central.beton.centrale</field>
        <field name="arch" type="xml">
            <form string="Centrale">
                <header>
                    <button name="action_set_operationnelle" string="Operationnelle"
                            type="object" class="btn-primary"
                            invisible="state == 'operationnelle'"/>
                    <button name="action_set_maintenance" string="Maintenance"
                            type="object" class="btn-warning"
                            invisible="state == 'maintenance'"/>
                    <button name="action_set_arret" string="Arreter"
                            type="object" class="btn-danger"
                            invisible="state == 'arret'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="operationnelle,maintenance,arret"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions" type="object"
                                class="oe_stat_button" icon="fa-industry">
                            <field name="production_count" widget="statinfo"
                                   string="Fabrications"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la Centrale"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="responsable_id"/>
                            <field name="capacite_horaire"/>
                        </group>
                        <group>
                            <field name="date_mise_service"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Adresse">
                        <field name="adresse" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Equipements" name="equipements">
                            <field name="equipement_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_centrale_tree" model="ir.ui.view">
        <field name="name">central.beton.centrale.tree</field>
        <field name="model">central.beton.centrale</field>
        <field name="arch" type="xml">
            <tree string="Centrales">
                <field name="name"/>
                <field name="code"/>
                <field name="responsable_id"/>
                <field name="capacite_horaire"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'operationnelle'"
                       decoration-warning="state == 'maintenance'"
                       decoration-danger="state == 'arret'"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_centrale_search" model="ir.ui.view">
        <field name="name">central.beton.centrale.search</field>
        <field name="model">central.beton.centrale</field>
        <field name="arch" type="xml">
            <search string="Centrales">
                <field name="name"/>
                <field name="code"/>
                <field name="responsable_id"/>
                <filter name="operationnelle" string="Operationnelle"
                        domain="[('state', '=', 'operationnelle')]"/>
                <filter name="maintenance" string="En Maintenance"
                        domain="[('state', '=', 'maintenance')]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_state" string="Etat"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_responsable" string="Responsable"
                            context="{'group_by': 'responsable_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_centrale" model="ir.actions.act_window">
        <field name="name">Centrales</field>
        <field name="res_model">central.beton.centrale</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Creer votre premiere centrale a beton
            </p>
        </field>
    </record>

</odoo>
