<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_product_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <!--                <field name="emplacement"/>-->
                <field name="emplacement_id"/>
            </xpath>
        </field>
    </record>



    <!-- ✅ Vue kanban : afficher l'emplacement sous forme texte -->

    <!-- Héritage de la vue kanban du modèle product.template -->
    <record id="product_product_kanban_view_inherit_emplacement" model="ir.ui.view">
    <field name="name">product.template.kanban.inherit.emplacement</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_kanban_view"/>
    <field name="arch" type="xml">
        <!-- Insertion après les propriétés du produit (donc à la fin) -->
        <xpath expr="//field[@name='product_properties']" position="after">
            <div name="product_emplacement" class="mt-1">
                Emplacement :
                <field name="emplacement_id"/>
            </div>
        </xpath>
    </field>
</record>




</odoo>