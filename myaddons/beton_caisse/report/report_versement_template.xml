<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_beton_versement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif;">
                        <div class="text-center" style="margin-bottom: 20px;">
                            <h2>Reçu de Versement</h2>
                            <h4 style="color: #667eea;"><t t-esc="doc.name"/></h4>
                        </div>
                        <table class="table table-bordered" style="margin-bottom: 20px;">
                            <tr>
                                <td style="width: 30%; font-weight: bold; background: #f8f9fa;">Date</td>
                                <td><t t-esc="doc.date" t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; background: #f8f9fa;">Partenaire</td>
                                <td><t t-esc="doc.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; background: #f8f9fa;">Type</td>
                                <td><t t-esc="{'client': 'Client', 'fournisseur': 'Fournisseur'}.get(doc.partner_type, '-')"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; background: #f8f9fa;">Caisse</td>
                                <td><t t-esc="doc.cashbox_id.name"/></td>
                            </tr>
                            <tr t-if="doc.description">
                                <td style="font-weight: bold; background: #f8f9fa;">Objet</td>
                                <td><t t-esc="doc.description"/></td>
                            </tr>
                        </table>
                        <div class="text-center" style="margin: 30px 0; padding: 20px; background: #d4edda; border-radius: 8px;">
                            <h3 style="margin: 0;">Montant versé</h3>
                            <h1 style="margin: 10px 0; color: #28a745;">
                                <t t-esc="doc.montant" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            </h1>
                        </div>
                        <div style="margin-top: 40px;">
                            <div class="row">
                                <div class="col-6 text-center">
                                    <p>Responsable : <t t-esc="doc.user_id.name"/></p>
                                </div>
                                <div class="col-6 text-center">
                                    <p>Signature :</p>
                                    <br/><br/>
                                    <p>_______________________</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
