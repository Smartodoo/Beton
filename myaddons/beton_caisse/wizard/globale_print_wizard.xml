<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_beton_globale_print_wizard_form" model="ir.ui.view">
        <field name="name">beton.globale.print.wizard.form</field>
        <field name="model">beton.globale.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer les Paiements">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="partner_type"/>
                        <field name="company_currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button string="Aperçu" name="action_preview_report"
                            type="object" class="btn-primary" icon="fa-eye"/>
                    <button string="Imprimer" name="action_print_report"
                            type="object" class="btn-secondary" icon="fa-print"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_beton_globale_print_wizard" model="ir.actions.act_window">
        <field name="name">Imprimer les Paiements</field>
        <field name="res_model">beton.globale.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
