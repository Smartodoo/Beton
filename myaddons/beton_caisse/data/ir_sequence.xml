<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="seq_beton_caisse_entry" model="ir.sequence">
        <field name="name">Encaissement Caisse Béton</field>
        <field name="code">beton.caisse.entry</field>
        <field name="prefix">ENC/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_beton_caisse_expense" model="ir.sequence">
        <field name="name">Décaissement Caisse Béton</field>
        <field name="code">beton.caisse.expense</field>
        <field name="prefix">DEC/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_beton_caisse_transfer" model="ir.sequence">
        <field name="name">Transfert Caisse Béton</field>
        <field name="code">beton.caisse.transfer</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_beton_versement" model="ir.sequence">
        <field name="name">Versement Caisse Béton</field>
        <field name="code">beton.versement</field>
        <field name="prefix">VRS/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
