<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Formulaire de paiement (après confirmation) -->
    <record id="view_account_payment_form_inherit_beton_caisse" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.beton.caisse</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="beton_cashbox_id"
                       options="{'no_create':True,'no_create_edit':True}"/>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="payment_method_code" invisible="1"/>
                <field name="cheque_reference"
                       string="N° de chèque"
                       invisible="payment_method_code != 'beton_cheque'"/>
                <field name="cheque_date"
                       string="Date du chèque"
                       invisible="payment_method_code != 'beton_cheque'"/>
                <field name="cheque_domiciliation"
                       string="Domiciliation bancaire"
                       invisible="payment_method_code != 'beton_cheque'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Informations bancaires (Caisse Béton)"
                       invisible="not beton_cashbox_id">
                    <group>
                        <field name="partner_bank_id"
                               string="Compte bancaire"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="ref" string="Référence"/>
                        <field name="date" string="Date paiement"/>
                    </group>
                    <group>
                        <field name="beton_bank_holder" string="Titulaire"/>
                        <field name="beton_bank_note" string="Observations"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Fiche de paiement depuis une facture (wizard) -->
    <record id="view_account_payment_register_form_inherit_beton_caisse" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.beton.caisse</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="beton_cashbox_id"
                       options="{'no_create':True,'no_create_edit':True}"/>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="payment_method_code" invisible="1"/>
                <field name="cheque_reference"
                       string="N° de chèque"
                       invisible="payment_method_code != 'beton_cheque'"/>
                <field name="cheque_date"
                       string="Date du chèque"
                       invisible="payment_method_code != 'beton_cheque'"/>
                <field name="cheque_domiciliation"
                       string="Domiciliation bancaire"
                       invisible="payment_method_code != 'beton_cheque'"/>
            </xpath>
            <xpath expr="//group[1]" position="after">
                <group string="Informations bancaires (Caisse Béton)"
                       invisible="not beton_cashbox_id">
                    <group>
                        <field name="partner_bank_id"
                               string="Compte bancaire"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="beton_bank_holder" string="Titulaire"/>
                        <field name="beton_bank_note" string="Observations"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
