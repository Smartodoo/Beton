<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form -->
    <record id="view_beton_caisse_globale_form" model="ir.ui.view">
        <field name="name">beton.caisse.globale.form</field>
        <field name="model">beton.caisse.globale</field>
        <field name="arch" type="xml">
            <form string="Dépenses Globales">
                <header>
                    <button name="%(beton_caisse.action_beton_globale_print_wizard)d"
                            type="action"
                            string="Imprimer les Paiements"
                            class="btn-primary"
                            context="{'default_globale_id': id}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_preview_report" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <span class="o_stat_text">Aperçu</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="partner_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="total_amount" widget="monetary" readonly="1"/>
                            <field name="total_paid_amount" widget="monetary" readonly="1"/>
                            <field name="total_residual_amount" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <!-- Encaissements (clients) -->
                    <group string="Encaissements" invisible="partner_type != 'client'">
                        <field name="entry_ids" readonly="1" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="company_currency_id" column_invisible="1"/>
                                <field name="amount" widget="monetary"/>
                                <field name="amount_verse" string="Versé" widget="monetary"/>
                                <field name="amount_residual" widget="monetary"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-success="state == 'approuve'"/>
                            </tree>
                        </field>
                    </group>
                    <!-- Décaissements (fournisseurs) -->
                    <group string="Décaissements" invisible="partner_type != 'fournisseur'">
                        <field name="expense_ids" readonly="1" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="company_currency_id" column_invisible="1"/>
                                <field name="amount" widget="monetary"/>
                                <field name="amount_verse" string="Versé" widget="monetary"/>
                                <field name="amount_residual" widget="monetary"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-success="state == 'approuve'"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree -->
    <record id="view_beton_caisse_globale_tree" model="ir.ui.view">
        <field name="name">beton.caisse.globale.tree</field>
        <field name="model">beton.caisse.globale</field>
        <field name="arch" type="xml">
            <tree string="Dépenses Globales" create="0">
                <field name="partner_id"/>
                <field name="partner_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="total_amount" widget="monetary"/>
                <field name="total_paid_amount" widget="monetary"/>
                <field name="total_residual_amount" widget="monetary"/>
            </tree>
        </field>
    </record>

    <!-- Search -->
    <record id="view_beton_caisse_globale_search" model="ir.ui.view">
        <field name="name">beton.caisse.globale.search</field>
        <field name="model">beton.caisse.globale</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <separator/>
                <filter string="Client" name="client" domain="[('partner_type','=','client')]"/>
                <filter string="Fournisseur" name="fournisseur" domain="[('partner_type','=','fournisseur')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Partenaire" name="partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Type" name="type" context="{'group_by':'partner_type'}"/>
                    <filter string="Société" name="company" context="{'group_by':'company_id'}"/>
                    <filter string="Date" name="date" context="{'group_by':'date_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Server Action aperçu multi -->
    <record id="action_preview_beton_globale_multi" model="ir.actions.server">
        <field name="name">Aperçu PDF</field>
        <field name="model_id" ref="model_beton_caisse_globale"/>
        <field name="binding_model_id" ref="model_beton_caisse_globale"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_preview_report_multi()</field>
    </record>

    <!-- Action -->
    <record id="action_beton_caisse_globale" model="ir.actions.act_window">
        <field name="name">Dépenses Globales</field>
        <field name="res_model">beton.caisse.globale</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('partner_type', '=', 'fournisseur')]</field>
        <field name="context">{'default_partner_type': 'fournisseur', 'search_default_fournisseur': 1}</field>
    </record>
</odoo>
