<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form -->
    <record id="view_beton_cashbox_form" model="ir.ui.view">
        <field name="name">beton.cashbox.form</field>
        <field name="model">beton.cashbox</field>
        <field name="arch" type="xml">
            <form string="Caisse Béton">
                <header>
                    <button name="action_recharge" type="object"
                            string="Enrichir" class="btn-primary"
                            icon="fa-plus-circle"
                            invisible="type != 'principale'"/>
                    <button name="action_repair_cumul_verse" type="object"
                            string="Réparer cumul versé" class="btn-warning"
                            icon="fa-wrench"
                            invisible="1"
                            groups="base.group_system"
                            confirm="Cette action va recalculer le champ 'Cumul versé' pour tous les encaissements et décaissements approuvés. À utiliser une seule fois pour corriger les données. Continuer ?"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archivée"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_entries" type="object"
                                class="oe_stat_button" icon="fa-arrow-down"
                                invisible="type != 'principale'">
                            <field name="entry_count" widget="statinfo" string="Encaissements"/>
                        </button>
                        <button name="action_view_expenses" type="object"
                                class="oe_stat_button" icon="fa-arrow-up">
                            <field name="expense_count" widget="statinfo" string="Décaissements"/>
                        </button>
                        <button name="action_view_transfers" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="transfer_count" widget="statinfo" string="Transferts"/>
                        </button>
                        <button name="action_view_recharges" type="object"
                                class="oe_stat_button" icon="fa-battery-full">
                            <field name="recharge_count" widget="statinfo" string="Recharges"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la caisse"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="responsible_ids" widget="many2many_tags"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree -->
    <record id="view_beton_cashbox_tree" model="ir.ui.view">
        <field name="name">beton.cashbox.tree</field>
        <field name="model">beton.cashbox</field>
        <field name="arch" type="xml">
            <tree string="Caisses Béton" edit="0">
                <field name="name"/>
                <field name="type"/>
                <field name="responsible_ids" widget="many2many_tags"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="total_amount" widget="monetary"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_beton_cashbox_kanban" model="ir.ui.view">
        <field name="name">beton.cashbox.kanban</field>
        <field name="model">beton.cashbox</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="true">
                <field name="name"/>
                <field name="type"/>
                <field name="total_amount"/>
                <field name="company_currency_id"/>
                <field name="entry_count"/>
                <field name="expense_count"/>
                <field name="transfer_count"/>
                <field name="recharge_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="min-width: 320px; margin: 8px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.12);">
                            <!-- Header -->
                            <div t-attf-style="background: linear-gradient(135deg, #{record.type.raw_value == 'principale' ? '#667eea' : '#28a745'} 0%, #{record.type.raw_value == 'principale' ? '#764ba2' : '#20c997'} 100%); padding: 20px; color: white;">
                                <div style="display: flex; align-items: center;">
                                    <div style="width: 48px; height: 48px; background: rgba(255,255,255,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 12px;">
                                        <i t-attf-class="fa #{record.type.raw_value == 'principale' ? 'fa-university' : 'fa-leaf'} fa-lg"
                                           style="color: white;"
                                           title="Type de caisse"
                                           role="img"
                                           aria-label="Type de caisse"/>
                                    </div>
                                    <div>
                                        <h3 style="margin: 0; font-weight: 600; font-size: 18px;">
                                            <field name="name"/>
                                        </h3>
                                        <small style="opacity: 0.9;">
                                            <field name="type"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <!-- Solde -->
                            <div style="padding: 16px; text-align: center; background: #f8f9fa;">
                                <span style="font-size: 11px; color: #6c757d; text-transform: uppercase; font-weight: 600;">Solde</span>
                                <div style="font-size: 28px; font-weight: 700; color: #212529; margin-top: 4px;">
                                    <field name="total_amount" widget="monetary"/>
                                </div>
                            </div>
                            <!-- Stats -->
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #e9ecef;">
                                <div style="background: white; padding: 12px; text-align: center;">
                                    <div style="font-size: 20px; font-weight: 700; color: #667eea;"><t t-esc="record.entry_count.value"/></div>
                                    <div style="font-size: 10px; color: #6c757d; text-transform: uppercase;">Encaissements</div>
                                </div>
                                <div style="background: white; padding: 12px; text-align: center;">
                                    <div style="font-size: 20px; font-weight: 700; color: #dc3545;"><t t-esc="record.expense_count.value"/></div>
                                    <div style="font-size: 10px; color: #6c757d; text-transform: uppercase;">Décaissements</div>
                                </div>
                                <div style="background: white; padding: 12px; text-align: center;">
                                    <div style="font-size: 20px; font-weight: 700; color: #fd7e14;"><t t-esc="record.transfer_count.value"/></div>
                                    <div style="font-size: 10px; color: #6c757d; text-transform: uppercase;">Transferts</div>
                                </div>
                                <div style="background: white; padding: 12px; text-align: center;">
                                    <div style="font-size: 20px; font-weight: 700; color: #28a745;"><t t-esc="record.recharge_count.value"/></div>
                                    <div style="font-size: 10px; color: #6c757d; text-transform: uppercase;">Recharges</div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search -->
    <record id="view_beton_cashbox_search" model="ir.ui.view">
        <field name="name">beton.cashbox.search</field>
        <field name="model">beton.cashbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="responsible_ids"/>
                <separator/>
                <filter string="Principale" name="principale" domain="[('type', '=', 'principale')]"/>
                <filter string="Secondaire" name="secondaire" domain="[('type', '=', 'secondaire')]"/>
                <separator/>
                <filter string="Archivées" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_beton_cashbox" model="ir.actions.act_window">
        <field name="name">Caisses Béton</field>
        <field name="res_model">beton.cashbox</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
