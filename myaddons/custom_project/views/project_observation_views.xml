<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_project_observation_tree" model="ir.ui.view">
        <field name="name">project.observation.tree</field>
        <field name="model">project.observation</field>
        <field name="arch" type="xml">
            <tree string="Observations">
                <field name="name"/>
                <field name="date_start"/>
                <field name="user_id"/>
                <field name="obs_type"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <!-- Form view -->
    <record id="view_project_observation_form" model="ir.ui.view">
        <field name="name">project.observation.form</field>
        <field name="model">project.observation</field>
        <field name="arch" type="xml">
            <form string="Observation">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,done"/>
                    <button name="action_mark_done" type="object" string="Mark Done" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_start"/>
                        <field name="user_id"/>
                        <field name="project_id" invisible="1"/>
                        <field name="partner_id"/>
                        <field name="obs_type"/>
                        <field name="is_action_required"/>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Calendar view -->
    <record id="view_project_observation_calendar" model="ir.ui.view">
        <field name="name">project.observation.calendar</field>
        <field name="model">project.observation</field>
        <field name="arch" type="xml">
            <calendar string="Observations" date_start="date_start" date_stop="date_stop" color="obs_type">
                <field name="name"/>
                <field name="project_id"/>
            </calendar>
        </field>
    </record>

