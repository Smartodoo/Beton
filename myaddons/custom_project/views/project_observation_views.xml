<!--        </field>-->
<!--    </record>-->

    <!-- Action -->
    <record id="action_project_observations" model="ir.actions.act_window">
        <field name="name">Observations</field>
        <field name="res_model">project.observation</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
    </record>

