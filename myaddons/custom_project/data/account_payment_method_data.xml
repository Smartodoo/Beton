    <!-- =========================== -->

    <!-- Virement (Entrant) -->
    <record id="account_payment_method_virement_in" model="account.payment.method">
        <field name="name">Virement (Entrant)</field>
        <field name="code">virement_in</field>
        <field name="payment_type">inbound</field>
    </record>

