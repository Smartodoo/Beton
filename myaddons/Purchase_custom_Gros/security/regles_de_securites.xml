<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ================= INVENTAIRE ================= -->

        <!-- Groupe Inventaire : Voir ses propres documents -->
        <record id="group_inventory_own_documents" model="res.groups">
            <field name="name">Voir ses propres documents</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <!-- toujours hériter de base.group_user pour accès minimal -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Remplacer la hiérarchie Inventaire standard -->
        <!-- Utilisateur Inventaire -->
        <record id="stock.group_stock_user" model="res.groups">
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Administrateur Inventaire -->
        <record id="stock.group_stock_manager" model="res.groups">
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- ================= ACHATS ================= -->

        <!-- Groupe Achats : Voir ses propres documents -->
        <record id="group_purchase_own_documents" model="res.groups">
            <field name="name">Voir ses propres documents</field>
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Remplacer la hiérarchie Achats standard -->
        <!-- Utilisateur Achats -->
        <record id="purchase.group_purchase_user" model="res.groups">
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Administrateur Achats -->
        <record id="purchase.group_purchase_manager" model="res.groups">
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- ================= REGLES DE SECURITE ================= -->

        <!-- Produits créés par l'utilisateur -->
        <record id="rule_product_template_own" model="ir.rule">
            <field name="name">Inventaire: Produits créés par l'utilisateur</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="global" eval="False"/>
            <field name="domain_force">
                ['|', ('create_uid', '=', user.id), ('id', '=', False)]
            </field>
            <field name="groups" eval="[(4, ref('Purchase_custom_Gros.group_inventory_own_documents'))]"/>
        </record>
        <record id="rule_product_product_own" model="ir.rule">
            <field name="name">Inventaire: Variantes de produits créés par l'utilisateur</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="global" eval="False"/>
            <field name="domain_force">
                ['|', ('product_tmpl_id.create_uid', '=', user.id), ('id', '=', False)]
            </field>
            <field name="groups" eval="[(4, ref('Purchase_custom_Gros.group_inventory_own_documents'))]"/>
        </record>


        <!-- Commandes d'achat de l'utilisateur -->
        <record id="rule_purchase_order_own" model="ir.rule">
            <field name="name">Achats: Commandes faites par l'utilisateur</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('Purchase_custom_Gros.group_purchase_own_documents'))]"/>
        </record>


    </data>
</odoo>
