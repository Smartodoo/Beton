<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_beton_objectif_wizard_form" model="ir.ui.view">
        <field name="name">beton.objectif.wizard.form</field>
        <field name="model">beton.objectif.wizard</field>
        <field name="arch" type="xml">
            <form string="Objectif de production">
                <p>
                    L'objectif saisi ci-dessous sera appliqué à
                    <strong>tous les ordres de fabrication</strong>.
                </p>
                <group>
                    <field name="objectif"/>
                </group>
                <footer>
                    <button string="Appliquer à tous les ordres"
                            name="action_appliquer" type="object"
                            class="btn-primary"/>
                    <button string="Annuler" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_beton_objectif_wizard" model="ir.actions.act_window">
        <field name="name">Objectif de Production</field>
        <field name="res_model">beton.objectif.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_beton_objectif_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
