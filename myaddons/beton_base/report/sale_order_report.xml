<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Héritage du rapport standard Bon de commande / Devis
         Ajoute uniquement Chantier + N° Facture + récap coût. -->
    <template id="report_saleorder_document_inherit_beton"
              inherit_id="sale.report_saleorder_document">

        <!-- Bloc d'infos spécifiques béton, juste après le titre -->
        <xpath expr="//div[hasclass('page')]//h2[1]" position="after">
            <div class="mt-3 mb-3 p-2" name="beton_infos_sale"
                 style="background:#f7fafc; border:1px solid #d0dde9;
                        border-left:4px solid #1a3c69; border-radius:3px;
                        overflow-wrap:break-word; word-wrap:break-word;">
                <div class="row" style="margin:0;">
                    <div class="col-6" style="padding:4px 8px; overflow-wrap:break-word; word-wrap:break-word; word-break:break-all;">
                        <span style="color:#5a6c7d; font-size:10px;
                                     text-transform:uppercase; letter-spacing:0.5px;
                                     font-weight:600; display:block;">Chantier</span>
                        <span style="font-weight:700; overflow-wrap:break-word; word-wrap:break-word; word-break:break-all;"
                              t-esc="doc.chantier or '—'"/>
                    </div>
                    <div class="col-6" style="padding:4px 8px; overflow-wrap:break-word; word-wrap:break-word; word-break:break-all;">
                        <span style="color:#5a6c7d; font-size:10px;
                                     text-transform:uppercase; letter-spacing:0.5px;
                                     font-weight:600; display:block;">N° Facture</span>
                        <span style="font-weight:700; overflow-wrap:break-word; word-wrap:break-word; word-break:break-all;"
                              t-esc="', '.join(doc.invoice_ids.filtered(lambda i: i.state != 'cancel').mapped('name')) or '—'"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Récap coût avant le bloc "total" -->
        <xpath expr="//div[@id='total']" position="before">
            <div class="mt-3 p-2" name="beton_recap_cout_sale"
                 style="background:#1a3c69; color:#fff; border-radius:3px;">
                <strong>Coût total (interne) :</strong>
                <span t-esc="'%.2f' % sum(l.product_uom_qty * l.product_id.standard_price for l in doc.order_line if not l.display_type)"/>
                <span t-field="doc.currency_id.symbol"/>
            </div>

            <div class="mt-2" name="beton_detail_cout_sale"
                 t-if="doc.order_line.filtered(lambda l: not l.display_type)">
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                    <tbody>
                        <t t-foreach="doc.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                            <tr t-att-style="'background:#f7fafc;' if line_index % 2 == 0 else ''">
                                <td style="padding:6px 8px; border-bottom:1px solid #e6edf3; width:70%;">
                                    <span t-esc="line.product_id.display_name"/>
                                </td>
                                <td class="text-end"
                                    style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                    Coût : <strong t-esc="'%.2f' % (line.product_uom_qty * line.product_id.standard_price)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>

        <!-- Montant en lettres, après le bloc total standard -->
        <xpath expr="//div[@id='total']" position="after">
            <div style="margin-top: 15px; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; background: #f8f9fa;">
                <strong>Arrêté le montant à la somme de :</strong>
                <br/>
                <span style="font-style: italic;">
                    <t t-esc="doc.currency_id.amount_to_text(doc.amount_total) if doc.currency_id else '%.2f' % doc.amount_total"/>
                </span>
            </div>
        </xpath>
    </template>
</odoo>
