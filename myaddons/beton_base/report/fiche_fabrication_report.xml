<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_fiche_fabrication" model="ir.actions.report">
        <field name="name">Fiche de Fabrication Béton</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_fiche_fabrication</field>
        <field name="report_file">beton_base.report_fiche_fabrication</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fiche_fabrication">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <style>
                        .footer div.text-muted { display: none !important; }
                    </style>
                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt; color: #222; padding:0;">
                        <table style="width:100%; min-height:850px; border:none; border-collapse:collapse;">
                            <tr>
                                <td style="vertical-align:top; padding:0; border:none;">

                        <t t-set="bon_commande"
                           t-value="o.env['sale.order'].search([('production_beton_id', '=', o.id)], order='date_order desc', limit=1)"/>

                        <!-- Titre -->
                        <div style="text-align:center; margin-bottom:20px; border-bottom:3px solid #1F4E79; padding-bottom:10px;">
                            <h2 style="color:#1F4E79; font-size:22pt; font-weight:700; letter-spacing:3px; margin:0;">
                                FICHE DE FABRICATION BÉTON
                            </h2>
                        </div>

                        <!-- Section Informations générales -->
                        <div style="background:#1F4E79; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Informations générales
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">N° Fabrication</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;" t-field="o.name"/>
                                </td>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">N° Bon de Commande</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="bon_commande.name or '—'"/></div>
                                </td>
                                <td style="width:34%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Date de la Commande</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="bon_commande" t-esc="bon_commande.date_order.strftime('%d/%m/%Y') if bon_commande.date_order else '—'"/>
                                        <t t-if="not bon_commande">—</t>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Date de fabrication</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-set="date_fab" t-value="o.date_finished or o.date_start"/>
                                        <t t-esc="date_fab.strftime('%d/%m/%Y %H:%M') if date_fab else '—'"/>
                                    </div>
                                </td>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Centrale</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.centrale_id.name or '—'"/></div>
                                </td>
                                <td style="width:34%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Chantier</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.chantier or '—'"/></div>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Distance</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.distance" t-esc="'%.1f km' % o.distance"/>
                                        <t t-if="not o.distance">—</t>
                                    </div>
                                </td>
                                <td colspan="2" style="padding:5px 8px; border:1px solid #ccc;"/>
                            </tr>
                        </table>

                        <!-- Section Informations Client -->
                        <div style="background:#1F4E79; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Informations Client
                        </div>
                        <t t-if="o.client_id">
                            <t t-set="client" t-value="o.client_id"/>
                            <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                                <tr>
                                    <td style="width:28%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8; vertical-align:top;">
                                        <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Raison sociale</div>
                                        <div style="font-size:12pt; font-weight:500; margin-top:2px;" t-esc="client.name or '—'"/>
                                    </td>
                                    <td style="width:32%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8; vertical-align:top;">
                                        <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Adresse</div>
                                        <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                            <t t-if="client.street"><t t-esc="client.street"/><br/></t>
                                            <t t-if="client.street2"><t t-esc="client.street2"/><br/></t>
                                            <t t-if="client.zip"><t t-esc="client.zip"/> </t><t t-if="client.city" t-esc="client.city"/>
                                            <t t-if="client.country_id"><br/><t t-esc="client.country_id.name"/></t>
                                            <t t-if="not client.street and not client.city">—</t>
                                        </div>
                                    </td>
                                    <td style="width:22%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8; vertical-align:top;">
                                        <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Chantier</div>
                                        <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.chantier or '—'"/></div>
                                    </td>
                                    <td style="width:18%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8; vertical-align:top;">
                                        <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Distance</div>
                                        <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                            <t t-if="o.distance" t-esc="'%.1f km' % o.distance"/>
                                            <t t-if="not o.distance">—</t>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <t t-if="client.rc or client.nis or client.nif or client.ai">
                                <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                                    <tr>
                                        <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                            <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">RC</div>
                                            <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="client.rc or '—'"/></div>
                                        </td>
                                        <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                            <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">NIS</div>
                                            <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="client.nis or '—'"/></div>
                                        </td>
                                        <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                            <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">NIF</div>
                                            <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="client.nif or '—'"/></div>
                                        </td>
                                        <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                            <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">AI</div>
                                            <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="client.ai or '—'"/></div>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                        </t>
                        <t t-if="not o.client_id">
                            <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                                <tr>
                                    <td style="padding:5px 8px; border:1px solid #ccc; background:#f0f4f8; font-size:12pt; font-weight:500;">
                                        Aucun client renseigné
                                    </td>
                                </tr>
                            </table>
                        </t>

                        <!-- Section Produit -->
                        <div style="background:#1F4E79; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Produit
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Produit</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.product_id.name or '—'"/></div>
                                </td>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Nomenclature</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.bom_id.display_name or '—'"/></div>
                                </td>
                                <td style="width:34%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Service inclus</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.inclure_service"><t t-esc="o.service_product_id.name or 'Oui'"/></t>
                                        <t t-if="not o.inclure_service">Non</t>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Section Quantités & Horaires -->
                        <div style="background:#1F4E79; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Quantités &amp; Horaires
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Qté demandée</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-esc="'%.2f' % o.product_qty"/> <span t-field="o.product_uom_id"/>
                                    </div>
                                </td>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Qté produite</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-esc="'%.2f' % o.qty_produced"/> <span t-field="o.product_uom_id"/>
                                    </div>
                                </td>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Nb gâchées</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.nombre_gachees"/></div>
                                </td>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Nb camions</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.nombre_camion"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- Section Consommation matières -->
                        <div style="background:#1F4E79; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Consommation matières
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;" t-if="o.move_raw_ids">
                            <thead>
                                <tr style="background:#1F4E79; color:#fff;">
                                    <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:left;">Matière</th>
                                    <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:right;">Qté prévue</th>
                                    <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:right;">Qté consommée</th>
                                    <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:left;">UdM</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.move_raw_ids" t-as="m">
                                    <tr t-attf-style="background:{{ '#f0f4f8' if m_index % 2 == 0 else '#fff' }};">
                                        <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt;"><span t-field="m.product_id.name"/></td>
                                        <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt; text-align:right;"><t t-esc="'%.2f' % m.product_uom_qty"/></td>
                                        <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt; text-align:right;"><t t-esc="'%.2f' % m.quantity"/></td>
                                        <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt;"><span t-field="m.product_uom"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Section Observation -->
                        <div style="background:#1F4E79; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Observation
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="padding:10px; border:1px solid #ccc; background:#f0f4f8; min-height:80px; height:80px;">
                                    &#160;
                                </td>
                            </tr>
                        </table>

                                </td>
                            </tr>
                        </table>

                        <!-- Signatures -->
                        <div style="overflow:hidden; margin-top:2cm;">
                            <div style="float:left; width:30%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Opérateur
                            </div>
                            <div style="float:left; width:5%;">&#160;</div>
                            <div style="float:left; width:30%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Responsable
                            </div>
                            <div style="float:left; width:5%;">&#160;</div>
                            <div style="float:left; width:30%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Directeur
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
