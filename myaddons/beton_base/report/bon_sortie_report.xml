<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_bon_sortie" model="ir.actions.report">
        <field name="name">Bon de Sortie</field>
        <field name="model">beton.bon.sortie</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_bon_sortie</field>
        <field name="report_file">beton_base.report_bon_sortie</field>
        <field name="binding_model_id" ref="model_beton_bon_sortie"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bon_sortie">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">BON DE SORTIE</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>N° Bon :</strong> <span t-field="o.name"/><br/>
                                <strong>Date de sortie :</strong> <span t-field="o.date"/><br/>
                                <strong>Société :</strong> <span t-field="o.company_id.name"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Client :</strong> <span t-field="o.partner_id.name"/><br/>
                                <t t-if="o.partner_id.street">
                                    <strong>Adresse :</strong> <span t-field="o.partner_id.street"/><br/>
                                </t>
                                <t t-if="o.partner_id.phone">
                                    <strong>Tél :</strong> <span t-field="o.partner_id.phone"/><br/>
                                </t>
                                <t t-if="o.partner_id.rc or o.partner_id.nif">
                                    <strong>RC :</strong> <span t-field="o.partner_id.rc"/>
                                    <strong> NIF :</strong> <span t-field="o.partner_id.nif"/><br/>
                                </t>
                            </div>
                        </div>

                        <t t-if="o.sale_order_id or o.chantier">
                            <div class="row mt-3">
                                <div class="col-6" t-if="o.sale_order_id">
                                    <strong>Bon de commande :</strong> <span t-field="o.sale_order_id.name"/>
                                </div>
                                <div class="col-6" t-if="o.chantier">
                                    <strong>Chantier :</strong> <span t-field="o.chantier"/>
                                </div>
                            </div>
                        </t>

                        <h4 class="mt-4">Détails du Service</h4>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Désignation</th>
                                    <th class="text-center">Quantité</th>
                                    <th>Unité</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.product_id.name"/></td>
                                    <td class="text-center"><span t-field="o.quantity"/></td>
                                    <td><span t-field="o.product_uom_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.description">
                            <h4 class="mt-3">Observations</h4>
                            <div class="border p-3">
                                <span t-field="o.description"/>
                            </div>
                        </t>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <strong>Signature Responsable</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <strong>Signature Client</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <strong>Signature Directeur</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
