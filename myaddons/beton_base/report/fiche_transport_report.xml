<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_fiche_transport" model="ir.actions.report">
        <field name="name">Fiche de Livraison</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_fiche_transport</field>
        <field name="report_file">beton_base.report_fiche_transport</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fiche_transport">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <style>
                        .footer div.text-muted { display: none !important; }
                    </style>
                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt; color: #222; padding:0;">
                        <table style="width:100%; min-height:850px; border:none; border-collapse:collapse;">
                            <tr>
                                <td style="vertical-align:top; padding:0; border:none;">

                        <!-- Titre -->
                        <div style="text-align:center; margin-bottom:20px; border-bottom:3px solid #1a3c69; padding-bottom:10px;">
                            <h2 style="color:#1a3c69; font-size:22pt; font-weight:700; letter-spacing:3px; margin:0;">
                                FICHE DE LIVRAISON
                            </h2>
                        </div>

                        <!-- Section Ordre de fabrication -->
                        <div style="background:#1a3c69; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Ordre de fabrication
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Référence OF</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;" t-field="o.name"/>
                                </td>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Produit</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.product_id.name or '—'"/></div>
                                </td>
                                <td style="width:34%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Date de fabrication</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-set="date_fab" t-value="o.date_finished or o.date_start"/>
                                        <t t-esc="date_fab.strftime('%d/%m/%Y %H:%M') if date_fab else '—'"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Client</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.client_id.name or '—'"/></div>
                                </td>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Chantier</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.chantier or '—'"/></div>
                                </td>
                                <td style="width:34%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Destination</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.destination or '—'"/></div>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Distance</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.distance" t-esc="'%.1f km' % o.distance"/>
                                        <t t-if="not o.distance">—</t>
                                    </div>
                                </td>
                                <td style="width:33%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Centrale</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.centrale_id.name or '—'"/></div>
                                </td>
                                <td style="width:34%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Nb camions</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.nombre_camion"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- Section Détail des transports -->
                        <div style="background:#1a3c69; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Détail des transports
                        </div>
                        <t t-if="o.transport_ligne_ids">
                            <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                                <thead>
                                    <tr style="background:#1a3c69; color:#fff;">
                                        <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:left;">#</th>
                                        <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:left;">Camion</th>
                                        <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:left;">Chauffeur</th>
                                        <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:right;">Quantité (m³)</th>
                                        <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:left;">Heure départ</th>
                                        <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:left;">Heure arrivée</th>
                                        <th style="padding:6px 8px; font-size:10pt; font-weight:600; text-align:right;">Attente (min)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.transport_ligne_ids" t-as="line">
                                        <tr t-attf-style="background:{{ '#f0f4f8' if line_index % 2 == 0 else '#fff' }};">
                                            <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt;"><t t-esc="line_index + 1"/></td>
                                            <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt;"><t t-esc="line.vehicle_id.name or '—'"/></td>
                                            <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt;"><t t-esc="line.chauffeur_id.name or '—'"/></td>
                                            <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt; text-align:right;"><t t-esc="'%.2f' % line.quantite"/></td>
                                            <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt;">
                                                <t t-if="line.heure_depart" t-esc="line.heure_depart.strftime('%d/%m/%Y %H:%M')"/>
                                                <t t-if="not line.heure_depart">—</t>
                                            </td>
                                            <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt;">
                                                <t t-if="line.heure_arrivee" t-esc="line.heure_arrivee.strftime('%d/%m/%Y %H:%M')"/>
                                                <t t-if="not line.heure_arrivee">—</t>
                                            </td>
                                            <td style="padding:5px 8px; border:1px solid #ccc; font-size:11pt; text-align:right;"><t t-esc="'%.0f' % line.temps_attente if line.temps_attente else '—'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="font-weight:700; background:#e8f0f7; border-top:2px solid #1a3c69;">
                                        <td colspan="3" style="padding:6px 8px; border:1px solid #ccc; font-size:11pt; text-align:right;">Total</td>
                                        <td style="padding:6px 8px; border:1px solid #ccc; font-size:11pt; text-align:right;">
                                            <t t-esc="'%.2f' % sum(o.transport_ligne_ids.mapped('quantite'))"/>
                                        </td>
                                        <td colspan="3" style="padding:6px 8px; border:1px solid #ccc;"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                        <t t-if="not o.transport_ligne_ids">
                            <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                                <tr>
                                    <td style="padding:5px 8px; border:1px solid #ccc; background:#f0f4f8; font-size:12pt; font-weight:500;">
                                        Aucune ligne de transport renseignée
                                    </td>
                                </tr>
                            </table>
                        </t>

                                </td>
                            </tr>
                        </table>

                        <!-- Signatures -->
                        <div style="overflow:hidden; margin-top:2cm;">
                            <div style="float:left; width:30%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Chauffeur
                            </div>
                            <div style="float:left; width:5%;">&#160;</div>
                            <div style="float:left; width:30%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Responsable
                            </div>
                            <div style="float:left; width:5%;">&#160;</div>
                            <div style="float:left; width:30%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Directeur
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
