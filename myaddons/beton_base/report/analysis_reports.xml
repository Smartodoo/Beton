    <template id="report_stock_move_analysis">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-call="beton_base.beton_analysis_styles"/>
                    <h2 class="beton-title">RAPPORT D'ANALYSE — MOUVEMENTS DE STOCK</h2>

                    <div class="row beton-filter-panel">
                        <div class="col-4">
                            <strong>Du :</strong> <span t-esc="data.get('filters', {}).get('date_from', 'Tous')"/><br/>
                            <strong>Au :</strong> <span t-esc="data.get('filters', {}).get('date_to', 'Tous')"/>
                        </div>
                        <div class="col-4">
                            <strong>Produit :</strong> <span t-esc="data.get('filters', {}).get('produit', 'Tous')"/><br/>
                            <strong>Statut :</strong> <span t-esc="data.get('filters', {}).get('statut', 'Tous')"/>
                        </div>
                        <div class="col-4">
                            <strong>Source :</strong> <span t-esc="data.get('filters', {}).get('emplacement_source', 'Tous')"/><br/>
                            <strong>Destination :</strong> <span t-esc="data.get('filters', {}).get('emplacement_dest', 'Tous')"/>
                        </div>
                    </div>

                    <div class="row beton-stats-panel">
                        <div class="col-3"><strong>Total mouvements :</strong> <span t-esc="data.get('total', 0)"/></div>
                        <div class="col-3"><strong>Quantité totale :</strong> <span t-esc="'%.2f' % data.get('qte_totale', 0)"/></div>
                        <div class="col-3"><strong>Coût total :</strong> <span t-esc="'%.2f' % data.get('cout_total', 0)"/></div>
                    </div>

                    <table class="beton-analysis-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Référence</th>
                                <th>Produit</th>
                                <th class="text-end">Quantité</th>
                                <th>UdM</th>
                                <th class="text-end">Coût unitaire</th>
                                <th class="text-end">Coût total</th>
                                <th>De</th>
                                <th>Vers</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td t-esc="doc.date" t-options='{"widget": "date"}'/>
                                    <td t-esc="doc.reference or ''"/>
                                    <td t-esc="doc.product_id.name"/>
                                    <td class="text-end" t-esc="'%.2f' % doc.product_uom_qty"/>
                                    <td t-esc="doc.product_uom.name"/>
                                    <td class="text-end" t-esc="'%.2f' % doc.price_unit"/>
                                    <td class="text-end" t-esc="'%.2f' % doc.cout_total"/>
                                    <td t-esc="doc.location_id.complete_name"/>
                                    <td t-esc="doc.location_dest_id.complete_name"/>
                                    <td t-esc="doc.state"/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3">Total</td>
                                <td class="text-end" t-esc="'%.2f' % sum(docs.mapped('product_uom_qty'))"/>
                                <td/>
                                <td/>
                                <td class="text-end" t-esc="'%.2f' % sum(docs.mapped('cout_total'))"/>
                                <td colspan="3"/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

