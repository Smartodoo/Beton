<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_fiche_essai" model="ir.actions.report">
        <field name="name">Fiche Essai Béton</field>
        <field name="model">beton.essai</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_fiche_essai</field>
        <field name="report_file">beton_base.report_fiche_essai</field>
        <field name="binding_model_id" ref="model_beton_essai"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fiche_essai">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">FICHE D'ESSAI BÉTON</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>N° Essai :</strong> <span t-field="o.name"/><br/>
                                <strong>Date :</strong> <span t-field="o.date"/><br/>
                                <strong>Laboratoire :</strong> <span t-field="o.nom_laboratoire"/><br/>
                                <strong>Référence lot :</strong> <span t-field="o.reference_lot"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Client :</strong> <span t-field="o.client_id.name"/><br/>
                                <strong>Chantier :</strong> <span t-field="o.chantier"/><br/>
                                <strong>Formule :</strong> <span t-field="o.formule_beton_id.name"/><br/>
                                <strong>Fabrication :</strong> <span t-field="o.fabrication_id.name"/><br/>
                                <t t-if="o.client_id.rc or o.client_id.nis or o.client_id.nif or o.client_id.ai">
                                    <strong>RC :</strong> <span t-field="o.client_id.rc"/>
                                    <strong> NIS :</strong> <span t-field="o.client_id.nis"/><br/>
                                    <strong>NIF :</strong> <span t-field="o.client_id.nif"/>
                                    <strong> AI :</strong> <span t-field="o.client_id.ai"/><br/>
                                </t>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Heure prélèvement :</strong> <span t-field="o.heure_prelevement" t-options='{"widget": "float_time"}'/>
                            </div>
                            <div class="col-6">
                                <strong>Température béton :</strong> <span t-field="o.temperature_beton"/> °C
                            </div>
                        </div>

                        <h4 class="mt-4">Résultats de Résistance</h4>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>7 jours (MPa)</th>
                                    <th>14 jours (MPa)</th>
                                    <th>21 jours (MPa)</th>
                                    <th>28 jours (MPa)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.resistance_7j"/></td>
                                    <td><span t-field="o.resistance_14j"/></td>
                                    <td><span t-field="o.resistance_21j"/></td>
                                    <td><span t-field="o.resistance_28j"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-3">
                            <strong>Conformité :</strong>
                            <span t-if="o.conforme == 'oui'" style="color: green; font-weight: bold;">Conforme</span>
                            <span t-if="o.conforme == 'non'" style="color: red; font-weight: bold;">Non conforme</span>
                            <span t-if="o.conforme == 'en_attente'" style="color: orange; font-weight: bold;">En attente</span>
                        </div>

                        <div class="mt-3" t-if="o.observations">
                            <strong>Observations :</strong>
                            <p t-field="o.observations"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <strong>Signature Laborantin</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                            <div class="col-6 text-center">
                                <strong>Signature Responsable</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
