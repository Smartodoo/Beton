<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_fiche_formule_beton" model="ir.actions.report">
        <field name="name">Fiche Formule Béton</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_fiche_formule_beton</field>
        <field name="report_file">beton_base.report_fiche_formule_beton</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fiche_formule_beton">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">FICHE FORMULE BÉTON</h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Produit :</strong> <span t-field="o.product_tmpl_id.name"/><br/>
                                <strong>Code formule :</strong> <span t-field="o.code_formule"/><br/>
                                <strong>Référence :</strong> <span t-field="o.code"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Classe de résistance :</strong>
                                <span t-if="o.classe_resistance" t-field="o.classe_resistance"/><br/>
                                <strong>Type de béton :</strong>
                                <span t-if="o.type_beton == 'bpe'">BPE</span>
                                <span t-if="o.type_beton == 'banche'">Béton banché</span>
                                <span t-if="o.type_beton == 'autoplacant'">Béton autoplaçant</span>
                                <span t-if="o.type_beton == 'fibre'">Béton fibré</span>
                                <span t-if="o.type_beton == 'autre'">Autre</span>
                                <br/>
                                <strong>Statut :</strong>
                                <span t-if="o.statut_formule == 'actif'" style="color: green; font-weight: bold;">Actif</span>
                                <span t-if="o.statut_formule == 'archive'" style="color: #6c757d; font-weight: bold;">Archivé</span>
                                <br/>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-4">
                                <strong>Rendement théorique :</strong> <span t-field="o.rendement_theorique"/> m³
                            </div>
                            <div class="col-4">
                                <strong>Tolérance dosage :</strong> <span t-field="o.tolerance_dosage"/> %
                            </div>
                            <div class="col-4">
                                <strong>Coût théorique / m³ :</strong> <span t-field="o.cout_theorique_m3"/>
                            </div>
                        </div>

                        <h4 class="mt-4">Composants</h4>
                        <table class="table table-bordered" t-if="o.bom_line_ids">
                            <thead>
                                <tr>
                                    <th>Matière première</th>
                                    <th class="text-end">Quantité</th>
                                    <th>Unité</th>
                                    <th class="text-end">Coût unitaire</th>
                                    <th class="text-end">Coût total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.bom_line_ids" t-as="l">
                                    <tr>
                                        <td><span t-field="l.product_id.name"/></td>
                                        <td class="text-end"><span t-field="l.product_qty"/></td>
                                        <td><span t-field="l.product_uom_id.name"/></td>
                                        <td class="text-end"><span t-esc="l.product_id.standard_price"/></td>
                                        <td class="text-end"><span t-esc="'%.2f' % (l.product_qty * l.product_id.standard_price)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">Coût total / m³</td>
                                    <td class="text-end"><span t-field="o.cout_theorique_m3"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <strong>Signature Laborantin</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <strong>Signature Responsable</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                            <div class="col-4 text-center">
                                <strong>Signature Directeur</strong>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
