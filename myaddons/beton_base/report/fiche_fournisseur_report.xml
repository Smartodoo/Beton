<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_fiche_fournisseur" model="ir.actions.report">
        <field name="name">Fiche Fournisseur</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_fiche_fournisseur</field>
        <field name="report_file">beton_base.report_fiche_fournisseur</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fiche_fournisseur">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .beton-title { color:#1F4E79; text-align:center; letter-spacing:2px;
                                           border-bottom:3px solid #1F4E79; padding-bottom:8px;
                                           margin-bottom:20px; font-weight:700; }
                            .beton-section-title { background:#1F4E79; color:#fff; padding:6px 10px;
                                                   margin-top:16px; margin-bottom:8px;
                                                   border-radius:3px; font-size:13px; font-weight:600;
                                                   letter-spacing:1px; text-transform:uppercase; }
                            .beton-info-card { border:1px solid #d0dde9; border-left:4px solid #1F4E79;
                                               padding:10px 14px; margin-bottom:8px;
                                               background:#f7fafc; border-radius:3px; }
                            .beton-info-card .label { color:#5a6c7d; font-size:11px;
                                                      text-transform:uppercase; letter-spacing:0.5px;
                                                      font-weight:600; display:block; margin-bottom:2px; }
                            .beton-info-card .value { color:#1a202c; font-size:13px; font-weight:500;
                                                      word-break:break-word; }
                            .beton-badge { display:inline-block; padding:2px 10px; border-radius:12px;
                                           font-size:11px; font-weight:600; }
                            .beton-badge-actif { background:#d4edda; color:#155724; }
                            .beton-badge-bloque { background:#f8d7da; color:#721c24; }
                            .beton-badge-archive { background:#e2e3e5; color:#383d41; }
                            .beton-sign-box { border-top:1px solid #333; margin-top:60px;
                                              padding-top:6px; text-align:center; font-weight:600; }
                        </style>

                        <h2 class="beton-title">FICHE FOURNISSEUR</h2>

                        <div class="beton-section-title">Identification</div>
                        <div class="row">
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Code Fournisseur</span>
                                    <span class="value" t-esc="o.code_fournisseur or '—'"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Raison sociale</span>
                                    <span class="value" t-esc="o.name or '—'"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Classification</span>
                                    <span class="value"
                                          t-esc="dict(o._fields['classification_fournisseur'].selection).get(o.classification_fournisseur, '—') if o.classification_fournisseur else '—'"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Contact</span>
                                    <span class="value"
                                          t-esc="', '.join(o.child_ids.filtered(lambda c: c.type == 'contact').mapped('name')) or '—'"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Mode de paiement</span>
                                    <span class="value"
                                          t-esc="dict(o._fields['mode_paiement_beton'].selection).get(o.mode_paiement_beton, '—') if o.mode_paiement_beton else '—'"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Statut</span>
                                    <t t-set="statut_label"
                                       t-value="dict(o._fields['statut_client_beton'].selection).get(o.statut_client_beton, '—') if o.statut_client_beton else '—'"/>
                                    <span t-attf-class="beton-badge beton-badge-#{o.statut_client_beton or 'archive'}"
                                          t-esc="statut_label"/>
                                </div>
                            </div>
                        </div>

                        <div class="beton-section-title">Coordonnées</div>
                        <div class="row">
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Adresse</span>
                                    <span class="value">
                                        <t t-if="o.street"><span t-field="o.street"/><br/></t>
                                        <t t-if="o.street2"><span t-field="o.street2"/><br/></t>
                                        <span t-field="o.zip"/> <span t-field="o.city"/>
                                        <t t-if="o.state_id"><br/><span t-field="o.state_id.name"/></t>
                                        <t t-if="o.country_id"><br/><span t-field="o.country_id.name"/></t>
                                    </span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="beton-info-card">
                                    <span class="label">Téléphone</span>
                                    <span class="value" t-esc="o.phone or '—'"/>
                                </div>
                                <div class="beton-info-card">
                                    <span class="label">Mobile</span>
                                    <span class="value" t-esc="o.mobile or '—'"/>
                                </div>
                                <div class="beton-info-card">
                                    <span class="label">Fax</span>
                                    <span class="value" t-esc="o.fax or '—'"/>
                                </div>
                                <div class="beton-info-card">
                                    <span class="label">Email</span>
                                    <span class="value" t-esc="o.email or '—'"/>
                                </div>
                            </div>
                        </div>

                        <div class="beton-section-title">Coordonnées fiscales</div>
                        <div class="row">
                            <div class="col-3">
                                <div class="beton-info-card">
                                    <span class="label">NIF</span>
                                    <span class="value" t-esc="o.nif or '—'"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="beton-info-card">
                                    <span class="label">NIS</span>
                                    <span class="value" t-esc="o.nis or '—'"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="beton-info-card">
                                    <span class="label">RC</span>
                                    <span class="value" t-esc="o.rc or '—'"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="beton-info-card">
                                    <span class="label">AI</span>
                                    <span class="value" t-esc="o.ai or '—'"/>
                                </div>
                            </div>
                        </div>

                        <div class="beton-section-title">Coordonnées bancaires</div>
                        <div class="beton-info-card">
                            <span class="label">RIB</span>
                            <span class="value" t-esc="o.rib or '—'"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="beton-sign-box">Signature Fournisseur</div>
                            </div>
                            <div class="col-6">
                                <div class="beton-sign-box">Signature Responsable</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
