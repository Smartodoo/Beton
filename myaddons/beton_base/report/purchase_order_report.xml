<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Héritage du rapport standard Bon de commande fournisseur
         Ajoute uniquement N° Facture + Coût/Différence par ligne. -->
    <template id="report_purchaseorder_document_inherit_beton"
              inherit_id="purchase.report_purchaseorder_document">

        <!-- === Supprimer l'acheteur (Buyer) === -->
        <xpath expr="//div[@id='informations']//div[@t-if='o.user_id']" position="replace"/>

        <!-- === Ajouter la date de réception prévue après la date de commande === -->
        <xpath expr="//div[@id='informations']//div[@t-elif='o.date_order']" position="after">
            <div t-if="o.date_planned" class="col-3 bm-2">
                <strong>Date de la demande :</strong>
                <p t-field="o.date_planned" class="m-0"/>
            </div>
        </xpath>

        <!-- === Supprimer la colonne "Date Req." de l'en-tête du tableau === -->
        <xpath expr="//th[@name='th_date_req']" position="replace"/>

        <!-- === Supprimer la cellule date_planned de chaque ligne produit === -->
        <xpath expr="//span[@t-field='line.date_planned']/parent::td" position="replace"/>

        <!-- === Deux signataires en bas de page === -->
        <xpath expr="//p[@t-field='o.notes']" position="after">
            <div class="row mt-5" style="page-break-inside: avoid;">
                <div class="col-6 text-center">
                    <strong>Signataire</strong>
                    <br/><br/><br/><br/>
                    <p>____________________</p>
                </div>
                <div class="col-6 text-center">
                    <strong>Signataire</strong>
                    <br/><br/><br/><br/>
                    <p>____________________</p>
                </div>
            </div>
        </xpath>

        <!-- Récap + détail Coût/Différence avant le bloc "total" -->
        <xpath expr="//div[@id='total']" position="before">
            <t t-set="lines_prod" t-value="o.order_line.filtered(lambda l: not l.display_type)"/>
            <t t-set="cout_total"
               t-value="sum(l.product_qty * l.product_id.standard_price for l in lines_prod)"/>
            <t t-set="diff_total"
               t-value="sum((l.price_unit - l.product_id.standard_price) * l.product_qty for l in lines_prod)"/>

            <div class="row mt-3" name="beton_recap_cout_purchase">
                <div class="col-6">
                    <div class="p-2"
                         style="background:#1F4E79; color:#fff; border-radius:3px;">
                        <span style="color:#cfe2f3; font-size:10px;
                                     text-transform:uppercase; letter-spacing:0.5px;
                                     font-weight:600;">Coût standard (interne)</span><br/>
                        <strong style="font-size:15px;" t-esc="'%.2f' % cout_total"/>
                        <span t-field="o.currency_id.symbol"/>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-2"
                         t-att-style="'background:' + ('#c0392b' if diff_total > 0 else '#27ae60') + '; color:#fff; border-radius:3px;'">
                        <span style="color:rgba(255,255,255,0.85); font-size:10px;
                                     text-transform:uppercase; letter-spacing:0.5px;
                                     font-weight:600;">Différence de coût</span><br/>
                        <strong style="font-size:15px;" t-esc="'%.2f' % diff_total"/>
                        <span t-field="o.currency_id.symbol"/>
                    </div>
                </div>
            </div>

            <div class="mt-2" name="beton_detail_cout_purchase" t-if="lines_prod">
                <table style="width:100%; border-collapse:collapse; font-size:12px;
                              border:1px solid #d0dde9;">
                    <thead style="background:#1F4E79; color:#fff;">
                        <tr>
                            <th style="padding:7px 8px; text-align:left;">Produit</th>
                            <th style="padding:7px 8px; text-align:right;">Coût standard</th>
                            <th style="padding:7px 8px; text-align:right;">Différence</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines_prod" t-as="line">
                            <tr t-att-style="'background:#f7fafc;' if line_index % 2 == 0 else ''">
                                <td style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                    <span t-esc="line.product_id.display_name"/>
                                </td>
                                <td class="text-end"
                                    style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                    <span t-esc="'%.2f' % (line.product_qty * line.product_id.standard_price)"/>
                                </td>
                                <td class="text-end"
                                    style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                    <t t-set="diff" t-value="(line.price_unit - line.product_id.standard_price) * line.product_qty"/>
                                    <span t-att-style="'color:#c0392b;' if diff > 0 else 'color:#27ae60;'"
                                          t-esc="'%.2f' % diff"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>

        <!-- Montant en lettres, après le bloc total standard -->
        <xpath expr="//div[@id='total']" position="after">
            <div style="margin-top: 15px; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; background: #f8f9fa;">
                <strong>Arrêté le montant à la somme de :</strong>
                <br/>
                <span style="font-style: italic;">
                    <t t-esc="o.currency_id.amount_to_text(o.amount_total) if o.currency_id else '%.2f' % o.amount_total"/>
                </span>
            </div>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Rapport Liste des Bons d'Achats (impression groupée)         -->
    <!-- ============================================================ -->
    <record id="action_report_purchase_order_list" model="ir.actions.report">
        <field name="name">Imprimer en liste</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_purchase_order_list</field>
        <field name="report_file">beton_base.report_purchase_order_list</field>
        <field name="print_report_name">'Liste des Bons d Achats'</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_purchase_order_list">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Mapping statut français -->
                    <t t-set="state_fr" t-value="{
                        'draft': 'Demande de prix',
                        'sent': 'Demande de prix envoyée',
                        'to approve': 'À approuver',
                        'purchase': 'Bon de commande',
                        'done': 'Verrouillé',
                        'cancel': 'Annulé',
                    }"/>

                    <!-- Titre dynamique selon les statuts sélectionnés -->
                    <t t-set="nb_docs" t-value="len(docs)"/>
                    <t t-set="titre">LISTE DES BONS D'ACHATS</t>
                    <t t-if="len(docs.filtered(lambda o: o.state in ('draft', 'sent'))) == nb_docs">
                        <t t-set="titre">LISTE DES DEMANDES DE PRIX</t>
                    </t>
                    <t t-if="len(docs.filtered(lambda o: o.state == 'purchase')) == nb_docs">
                        <t t-set="titre">LISTE DES BONS DE COMMANDE</t>
                    </t>
                    <t t-if="len(docs.filtered(lambda o: o.state == 'done')) == nb_docs">
                        <t t-set="titre">LISTE DES BONS DE COMMANDE VERROUILLÉS</t>
                    </t>
                    <t t-if="len(docs.filtered(lambda o: o.state == 'cancel')) == nb_docs">
                        <t t-set="titre">LISTE DES BONS D'ACHATS ANNULÉS</t>
                    </t>

                    <h2 style="color:#1F4E79; border-bottom:2px solid #1F4E79;
                               padding-bottom:8px; margin-bottom:15px;">
                        <t t-out="titre"/>
                    </h2>

                    <div style="margin-bottom:15px; padding:8px 12px;
                                background:#f7fafc; border:1px solid #d0dde9;
                                border-left:4px solid #1F4E79; border-radius:3px;
                                font-size:12px;">
                        <strong>Nombre de bons :</strong>
                        <span t-esc="len(docs)"/>
                        <span style="margin-left:30px;">
                            <strong>Date d'impression :</strong>
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                        </span>
                    </div>

                    <table style="width:100%; border-collapse:collapse; font-size:11px;
                                  border:1px solid #d0dde9;">
                        <thead>
                            <tr style="background:#1F4E79; color:#fff;">
                                <th style="padding:7px 8px; text-align:left;">Référence</th>
                                <th style="padding:7px 8px; text-align:left;">Date</th>
                                <th style="padding:7px 8px; text-align:left;">Fournisseur</th>
                                <th style="padding:7px 8px; text-align:left;">Produits</th>
                                <th style="padding:7px 8px; text-align:right;">Montant HT</th>
                                <th style="padding:7px 8px; text-align:right;">Montant TTC</th>
                                <th style="padding:7px 8px; text-align:center;">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <tr t-att-style="'background:#f7fafc;' if o_index % 2 == 0 else ''">
                                    <td style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                        <span t-esc="o.name"/>
                                    </td>
                                    <td style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                        <span t-esc="o.date_order" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                        <span t-esc="o.partner_id.name or ''"/>
                                    </td>
                                    <td style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                        <span t-esc="', '.join(o.order_line.filtered(lambda l: not l.display_type).mapped('product_id.name'))"/>
                                    </td>
                                    <td class="text-end"
                                        style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                        <span t-esc="'%.2f' % o.amount_untaxed"/>
                                    </td>
                                    <td class="text-end"
                                        style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                        <span t-esc="'%.2f' % o.amount_total"/>
                                    </td>
                                    <td style="padding:6px 8px; border-bottom:1px solid #e6edf3;
                                               text-align:center;">
                                        <span t-esc="state_fr.get(o.state, o.state)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background:#1F4E79; color:#fff; font-weight:700;">
                                <td colspan="4" style="padding:7px 8px;">Total</td>
                                <td class="text-end" style="padding:7px 8px;">
                                    <span t-esc="'%.2f' % sum(docs.mapped('amount_untaxed'))"/>
                                </td>
                                <td class="text-end" style="padding:7px 8px;">
                                    <span t-esc="'%.2f' % sum(docs.mapped('amount_total'))"/>
                                </td>
                                <td/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
