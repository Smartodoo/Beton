<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Héritage du rapport standard Bon de commande fournisseur
         Ajoute uniquement N° Facture + Coût/Différence par ligne. -->
    <template id="report_purchaseorder_document_inherit_beton"
              inherit_id="purchase.report_purchaseorder_document">

        <!-- Bloc d'infos béton, juste après le titre -->
        <xpath expr="//div[hasclass('page')]//h2[1]" position="after">
            <div class="mt-3 mb-3 p-2" name="beton_infos_purchase"
                 style="background:#f7fafc; border:1px solid #d0dde9;
                        border-left:4px solid #1F4E79; border-radius:3px;
                        overflow-wrap:break-word; word-wrap:break-word;">
                <span style="color:#5a6c7d; font-size:10px;
                             text-transform:uppercase; letter-spacing:0.5px;
                             font-weight:600; display:block;">N° Facture</span>
                <span style="font-weight:700; overflow-wrap:break-word; word-wrap:break-word; word-break:break-all;"
                      t-esc="', '.join(o.invoice_ids.filtered(lambda i: i.state != 'cancel').mapped('name')) or '—'"/>
            </div>
        </xpath>

        <!-- Récap + détail Coût/Différence avant le bloc "total" -->
        <xpath expr="//div[@id='total']" position="before">
            <t t-set="lines_prod" t-value="o.order_line.filtered(lambda l: not l.display_type)"/>
            <t t-set="cout_total"
               t-value="sum(l.product_qty * l.product_id.standard_price for l in lines_prod)"/>
            <t t-set="diff_total"
               t-value="sum((l.price_unit - l.product_id.standard_price) * l.product_qty for l in lines_prod)"/>

            <div class="row mt-3" name="beton_recap_cout_purchase">
                <div class="col-6">
                    <div class="p-2"
                         style="background:#1F4E79; color:#fff; border-radius:3px;">
                        <span style="color:#cfe2f3; font-size:10px;
                                     text-transform:uppercase; letter-spacing:0.5px;
                                     font-weight:600;">Coût standard (interne)</span><br/>
                        <strong style="font-size:15px;" t-esc="'%.2f' % cout_total"/>
                        <span t-field="o.currency_id.symbol"/>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-2"
                         t-att-style="'background:' + ('#c0392b' if diff_total > 0 else '#27ae60') + '; color:#fff; border-radius:3px;'">
                        <span style="color:rgba(255,255,255,0.85); font-size:10px;
                                     text-transform:uppercase; letter-spacing:0.5px;
                                     font-weight:600;">Différence de coût</span><br/>
                        <strong style="font-size:15px;" t-esc="'%.2f' % diff_total"/>
                        <span t-field="o.currency_id.symbol"/>
                    </div>
                </div>
            </div>

            <div class="mt-2" name="beton_detail_cout_purchase" t-if="lines_prod">
                <table style="width:100%; border-collapse:collapse; font-size:12px;
                              border:1px solid #d0dde9;">
                    <thead style="background:#1F4E79; color:#fff;">
                        <tr>
                            <th style="padding:7px 8px; text-align:left;">Produit</th>
                            <th style="padding:7px 8px; text-align:right;">Coût standard</th>
                            <th style="padding:7px 8px; text-align:right;">Différence</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines_prod" t-as="line">
                            <tr t-att-style="'background:#f7fafc;' if line_index % 2 == 0 else ''">
                                <td style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                    <span t-esc="line.product_id.display_name"/>
                                </td>
                                <td class="text-end"
                                    style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                    <span t-esc="'%.2f' % (line.product_qty * line.product_id.standard_price)"/>
                                </td>
                                <td class="text-end"
                                    style="padding:6px 8px; border-bottom:1px solid #e6edf3;">
                                    <t t-set="diff" t-value="(line.price_unit - line.product_id.standard_price) * line.product_qty"/>
                                    <span t-att-style="'color:#c0392b;' if diff > 0 else 'color:#27ae60;'"
                                          t-esc="'%.2f' % diff"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>

        <!-- Montant en lettres, après le bloc total standard -->
        <xpath expr="//div[@id='total']" position="after">
            <div style="margin-top: 15px; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; background: #f8f9fa;">
                <strong>Arrêté le montant à la somme de :</strong>
                <br/>
                <span style="font-style: italic;">
                    <t t-esc="o.currency_id.amount_to_text(o.amount_total) if o.currency_id else '%.2f' % o.amount_total"/>
                </span>
            </div>
        </xpath>
    </template>
</odoo>
