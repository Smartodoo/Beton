<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_fiche_client" model="ir.actions.report">
        <field name="name">Fiche Client</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beton_base.report_fiche_client</field>
        <field name="report_file">beton_base.report_fiche_client</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fiche_client">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <style>
                        .footer div.text-muted { display: none !important; }
                    </style>
                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt; color: #222; padding:0;">
                        <table style="width:100%; min-height:850px; border:none; border-collapse:collapse;">
                            <!-- Contenu principal -->
                            <tr>
                                <td style="vertical-align:top; padding:0; border:none;">

                        <!-- Titre -->
                        <div style="text-align:center; margin-bottom:20px; border-bottom:3px solid #1a3c69; padding-bottom:10px;">
                            <h2 style="color:#1a3c69; font-size:22pt; font-weight:700; letter-spacing:3px; margin:0;">
                                FICHE CLIENT
                            </h2>
                        </div>

                        <!-- Section Identification -->
                        <div style="background:#1a3c69; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Identification
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:50%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Code Client</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.code_client" t-esc="o.code_client"/>
                                        <t t-if="not o.code_client">—</t>
                                    </div>
                                </td>
                                <td style="width:50%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Raison sociale</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.name" t-esc="o.name"/>
                                        <t t-if="not o.name">—</t>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:50%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Classification</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.classification_client"><span t-field="o.classification_client"/></t>
                                        <t t-if="not o.classification_client">—</t>
                                    </div>
                                </td>
                                <td style="width:50%; padding:5px 8px; border:1px solid #ccc;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Statut client</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.statut_client_beton"><span t-field="o.statut_client_beton"/></t>
                                        <t t-if="not o.statut_client_beton">—</t>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="padding:5px 8px; border:1px solid #ccc; background:#f0f4f8; text-align:center;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Satisfaction client</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.satisfaction_client"><span t-field="o.satisfaction_client"/></t>
                                        <t t-if="not o.satisfaction_client">—</t>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Section Conditions commerciales -->
                        <div style="background:#1a3c69; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Conditions commerciales
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:50%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Mode de paiement</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.mode_paiement_beton"><span t-field="o.mode_paiement_beton"/></t>
                                        <t t-if="not o.mode_paiement_beton">—</t>
                                    </div>
                                </td>
                                <td style="width:50%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Plafond crédit</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-esc="'%.2f' % (o.plafond_credit or 0)"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Section Coordonnées -->
                        <div style="background:#1a3c69; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Coordonnées
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:50%; padding:5px 8px; border:1px solid #ccc; vertical-align:top;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Adresse</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;">
                                        <t t-if="o.street"><t t-esc="o.street"/><br/></t>
                                        <t t-if="o.street2"><t t-esc="o.street2"/><br/></t>
                                        <t t-if="o.zip"><t t-esc="o.zip"/> </t><t t-if="o.city" t-esc="o.city"/>
                                        <t t-if="o.state_id"><br/><t t-esc="o.state_id.name"/></t>
                                        <t t-if="o.country_id"><br/><t t-esc="o.country_id.name"/></t>
                                        <t t-if="not o.street and not o.city">—</t>
                                    </div>
                                </td>
                                <td style="width:50%; padding:0; border:1px solid #ccc; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tr>
                                            <td style="padding:5px 8px; border-bottom:1px solid #ccc;">
                                                <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Téléphone</div>
                                                <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.phone or '—'"/></div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:5px 8px; border-bottom:1px solid #ccc;">
                                                <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Mobile</div>
                                                <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.mobile or '—'"/></div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:5px 8px; border-bottom:1px solid #ccc;">
                                                <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Fax</div>
                                                <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.fax or '—'"/></div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:5px 8px;">
                                                <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">Email</div>
                                                <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.email or '—'"/></div>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Section Coordonnées fiscales -->
                        <div style="background:#1a3c69; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Coordonnées fiscales
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">NIF</div>
                                    <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="o.nif or '—'"/></div>
                                </td>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">NIS</div>
                                    <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="o.nis or '—'"/></div>
                                </td>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">RC</div>
                                    <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="o.rc or '—'"/></div>
                                </td>
                                <td style="width:25%; padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">AI</div>
                                    <div style="font-size:11pt; font-weight:500; margin-top:2px;"><t t-esc="o.ai or '—'"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- Section Coordonnées bancaires -->
                        <div style="background:#1a3c69; color:#fff; padding:6px 12px; font-size:11pt; font-weight:700;
                                    letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; border-radius:2px;">
                            Coordonnées bancaires
                        </div>
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <td style="padding:5px 8px; border:1px solid #ccc; background:#f0f4f8;">
                                    <div style="font-size:9pt; color:#666; text-transform:uppercase; font-weight:600;">RIB</div>
                                    <div style="font-size:12pt; font-weight:500; margin-top:2px;"><t t-esc="o.rib or '—'"/></div>
                                </td>
                            </tr>
                        </table>

                                </td>
                            </tr>
                        </table>

                        <!-- Signatures -->
                        <div style="overflow:hidden; margin-top:4cm;">
                            <div style="float:left; width:45%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Client
                            </div>
                            <div style="float:right; width:45%; text-align:center; border-top:1.5px solid #333; padding-top:8px; font-weight:700; font-size:11pt;">
                                Signature Responsable
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
