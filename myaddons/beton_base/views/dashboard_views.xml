<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Action principale du dashboard -->
    <record id="action_beton_dashboard" model="ir.actions.client">
        <field name="name">Tableau de Bord</field>
        <field name="tag">beton_dashboard</field>
    </record>

    <!-- Fallback : vue formulaire du dashboard -->
    <record id="view_beton_dashboard_form" model="ir.ui.view">
        <field name="name">beton.dashboard.form</field>
        <field name="model">beton.dashboard</field>
        <field name="arch" type="xml">
            <form string="Tableau de Bord Béton" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Tableau de Bord - Centrale à Béton</h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====== Actions raccourcies depuis le dashboard ====== -->

    <!-- Fabrications du jour -->
    <record id="action_dashboard_fabrications_jour" model="ir.actions.act_window">
        <field name="name">Fabrications du jour</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('date_start', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00')), ('date_start', '&lt;=', (context_today()).strftime('%Y-%m-%d 23:59:59')), ('state', 'in', ('progress', 'done'))]</field>
    </record>

    <!-- Livraisons du jour -->
    <record id="action_dashboard_livraisons_jour" model="ir.actions.act_window">
        <field name="name">Livraisons du jour</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing'), ('scheduled_date', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00')), ('scheduled_date', '&lt;=', (context_today()).strftime('%Y-%m-%d 23:59:59')), ('state', '!=', 'cancel')]</field>
    </record>

    <!-- NC non traitées -->
    <record id="action_dashboard_nc_non_traitees" model="ir.actions.act_window">
        <field name="name">NC non traitées</field>
        <field name="res_model">beton.non.conformite</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('traitement', '=', 'non')]</field>
    </record>

    <!-- Équipements en panne -->
    <record id="action_dashboard_equipements_panne" model="ir.actions.act_window">
        <field name="name">Équipements en panne</field>
        <field name="res_model">maintenance.equipment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('etat_equipement', '=', 'panne')]</field>
    </record>

    <!-- Chantiers actifs -->
    <record id="action_dashboard_chantiers_actifs" model="ir.actions.act_window">
        <field name="name">Chantiers en cours</field>
        <field name="res_model">beton.chantier</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('statut', '=', 'en_cours')]</field>
    </record>

    <!-- Interventions en cours -->
    <record id="action_dashboard_interventions_cours" model="ir.actions.act_window">
        <field name="name">Interventions en cours</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('close_date', '=', False)]</field>
    </record>
</odoo>
