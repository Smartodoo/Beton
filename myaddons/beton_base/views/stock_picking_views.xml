<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Héritage vue formulaire stock.picking -->
    <record id="view_stock_picking_form_inherit_beton" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.beton</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Motif du retour : visible uniquement sur les bons de retour -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="return_id" invisible="1"/>
                <field name="motif_retour" invisible="not return_id"
                       placeholder="Motif du retour d'achat..."/>
            </xpath>

            <!-- Ajouter prix unitaire et coût dans l'onglet Opérations -->
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='product_uom_qty']" position="after">
                <field name="price_unit" string="Prix unitaire"/>
                <field name="cout_total" string="Coût" sum="Total"/>
            </xpath>

            <!-- Ajouter les champs béton dans un onglet dédié -->
            <xpath expr="//notebook" position="inside">
                <page string="Livraison Béton" name="beton_livraison">
                    <group>
                        <group string="Chantier">
                            <field name="chantier"/>
                            <field name="formule_beton_id"/>
                            <field name="distance"/>
                            <field name="adjuvant_chantier"/>
                        </group>
                        <group string="Transport">
                            <field name="vehicle_id"/>
                            <field name="chauffeur_id"/>
                            <field name="heure_depart"/>
                            <field name="heure_arrivee"/>
                            <field name="temps_attente"/>
                            <field name="temps_trajet"/>
                        </group>
                    </group>
                </page>
                <page string="Pièces jointes" name="documents_picking">
                    <field name="document_ids" widget="many2many_binary" string="Pièces jointes"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Héritage vue tree stock.picking -->
    <record id="view_stock_picking_tree_inherit_beton" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.beton</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="chantier" optional="show"/>
                <field name="vehicle_id" optional="show"/>
                <field name="chauffeur_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Action pour les livraisons sortantes (Bons de Livraison Béton) -->
    <record id="action_beton_stock_picking_livraison" model="ir.actions.act_window">
        <field name="name">Bons de Livraison Béton</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing')]</field>
        <field name="context" eval="{'default_picking_type_id': ref('stock.picking_type_out')}"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre premier bon de livraison béton
            </p>
        </field>
    </record>
</odoo>
