<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form View -->
    <record id="view_beton_centrale_form" model="ir.ui.view">
        <field name="name">beton.centrale.form</field>
        <field name="model">beton.centrale</field>
        <field name="arch" type="xml">
            <form string="Centrale à Béton">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la centrale"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="adresse"/>
                            <field name="capacite_horaire"/>
                            <field name="heures_travail_jour"/>
                            <field name="capacite_journaliere" readonly="1"/>
                        </group>
                        <group>
                            <field name="responsable_id"/>
                            <field name="etat"/>
                            <field name="warehouse_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Pièces jointes"/>
                    <field name="document_ids" widget="many2many_binary" string="Pièces jointes"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_beton_centrale_tree" model="ir.ui.view">
        <field name="name">beton.centrale.tree</field>
        <field name="model">beton.centrale</field>
        <field name="arch" type="xml">
            <tree string="Centrales">
                <field name="code"/>
                <field name="name"/>
                <field name="adresse"/>
                <field name="capacite_horaire"/>
                <field name="capacite_journaliere" optional="show"/>
                <field name="responsable_id"/>
                <field name="etat" widget="badge"
                       decoration-success="etat == 'operationnelle'"
                       decoration-warning="etat == 'maintenance'"
                       decoration-danger="etat == 'arret'"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_beton_centrale" model="ir.actions.act_window">
        <field name="name">Centrales</field>
        <field name="res_model">beton.centrale</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre première centrale à béton
            </p>
        </field>
    </record>
</odoo>
