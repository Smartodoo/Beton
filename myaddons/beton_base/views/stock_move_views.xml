<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Héritage vue formulaire stock.move -->
    <record id="view_stock_move_form_inherit_beton" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.beton</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='origin_grp']" position="before">
                <group string="Traçabilité Béton">
                    <field name="responsable_id"/>
                    <field name="justification"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Héritage vue tree stock.move (Historique des mouvements) -->
    <record id="view_stock_move_tree_inherit_beton" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.beton</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="price_unit" string="Coût unitaire" optional="show"/>
                <field name="cout_total" string="Coût total" sum="Total" optional="show"/>
                <field name="responsable_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Héritage vue tree stock.move.line (Analyse des mouvements) -->
    <record id="view_stock_move_line_tree_inherit_beton" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.beton</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="price_unit" string="Coût unitaire" optional="show"/>
                <field name="cout_total" string="Coût total" sum="Total" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Héritage vue tree détaillée stock.move.line -->
    <record id="view_stock_move_line_tree_detailed_inherit_beton" model="ir.ui.view">
        <field name="name">stock.move.line.tree.detailed.inherit.beton</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree_detailed"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="price_unit" string="Coût unitaire" optional="show"/>
                <field name="cout_total" string="Coût total" sum="Total" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
