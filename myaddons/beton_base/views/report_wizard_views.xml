<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ============================================================ -->
    <!-- 1. WIZARD RAPPORT PRODUITS -->
    <!-- ============================================================ -->
    <record id="view_product_report_wizard_form" model="ir.ui.view">
        <field name="name">product.report.wizard.form</field>
        <field name="model">product.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport Produits">
                <group>
                    <group string="Période">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filtres">
                        <field name="classification_produit"/>
                        <field name="supplier_id"/>
                    </group>
                </group>
                <group string="Type de matière">
                    <group>
                        <field name="type_matiere_ciment"/>
                        <field name="type_matiere_sable"/>
                        <field name="type_matiere_gravier"/>
                    </group>
                    <group>
                        <field name="type_matiere_adjuvant"/>
                        <field name="type_matiere_eau"/>
                        <field name="type_matiere_autre"/>
                    </group>
                </group>
                <group>
                    <group string="Critères">
                        <field name="statut_matiere"/>
                        <field name="emplacement_beton"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimer" class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_report_wizard" model="ir.actions.act_window">
        <field name="name">Rapport d'analyse Produits</field>
        <field name="res_model">product.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

