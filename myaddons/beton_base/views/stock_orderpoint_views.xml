<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Fiche de réapprovisionnement (Règles de réapprovisionnement) :
         ajout de la quantité disponible et du seuil minimum béton. -->
    <record id="view_orderpoint_tree_beton" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.beton</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <field name="qty_on_hand" position="after">
                <field name="qty_disponible" optional="show"/>
            </field>
            <field name="product_min_qty" position="after">
                <field name="seuil_minimum" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
