<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Héritage vue formulaire product.template -->
    <record id="view_product_template_form_inherit_beton" model="ir.ui.view">
        <field name="name">product.template.form.inherit.beton</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Rendre le type de produit modifiable après création -->
            <xpath expr="//field[@name='detailed_type']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- Champ classification produit en dessous du type de produit (onglet Informations générales) -->
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="classification_produit"/>
            </xpath>

            <!-- Rendre le coût readonly pour les matières premières (calculé automatiquement) -->
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="readonly">classification_produit == 'matiere_premiere'</attribute>
            </xpath>

            <!-- Champs Prix d'achat et Coût divers sous le Coût (matières premières) -->
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="prix_achat"
                       invisible="classification_produit != 'matiere_premiere'"/>
                <div name="prix_achat_div" class="o_row"
                     invisible="classification_produit != 'matiere_premiere'">
                    <field name="prix_achat" class="oe_inline" widget="monetary"
                           options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                </div>
                <label for="cout_divers"
                       invisible="classification_produit != 'matiere_premiere'"/>
                <div name="cout_divers_div" class="o_row"
                     invisible="classification_produit != 'matiere_premiere'">
                    <field name="cout_divers" class="oe_inline" widget="monetary"
                           options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                </div>
            </xpath>

            <!-- Onglets dans le notebook -->
            <xpath expr="//notebook" position="inside">
                <!-- Onglet Matière Béton (visible uniquement pour matières premières) -->
                <page string="Matière Béton" name="matiere_beton"
                      invisible="classification_produit != 'matiere_premiere'">
                    <group>
                        <group string="Classification">
                            <field name="type_matiere"/>
                            <field name="emplacement_beton"/>
                            <field name="statut_matiere"/>
                        </group>
                        <group string="Approvisionnement">
                            <field name="delai_approvisionnement"/>
                        </group>
                    </group>
                </page>
                <!-- Onglet Historique des coûts -->
                <page string="Historique Coûts" name="cost_history">
                    <field name="cost_history_ids" readonly="1">
                        <tree string="Historique des coûts" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0">
                            <field name="date"/>
                            <field name="source" widget="badge"
                                   decoration-info="source == 'purchase'"
                                   decoration-warning="source == 'manual'"/>
                            <field name="fournisseur_id"/>
                            <field name="purchase_order_id" optional="show"/>
                            <field name="ancien_cout"/>
                            <field name="difference"/>
                            <field name="nouveau_cout"/>
                            <field name="user_id"/>
                            <field name="note"/>
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Héritage vue recherche product.template -->
    <record id="view_product_template_search_inherit_beton" model="ir.ui.view">
        <field name="name">product.template.search.inherit.beton</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <!-- Remplacer le grouper par 'type' par 'detailed_type' pour inclure 'fabriqué' -->
            <xpath expr="//filter[@name='type']" position="attributes">
                <attribute name="context">{'group_by':'detailed_type'}</attribute>
            </xpath>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_sans_matiere_premiere"
                        string="Sans matières premières"
                        domain="[('classification_produit', '!=', 'matiere_premiere')]"/>
                <filter name="filter_produit_fabrique"
                        string="Produits fabriqués"
                        domain="[('detailed_type', '=', 'fabrique')]"/>
                <filter name="filter_matiere_premiere"
                        string="Matières premières"
                        domain="[('classification_produit', '=', 'matiere_premiere')]"/>
                <separator/>
                <filter name="filter_type_ciment" string="Ciment"
                        domain="[('type_matiere', '=', 'ciment')]"/>
                <filter name="filter_type_sable" string="Sable"
                        domain="[('type_matiere', '=', 'sable')]"/>
                <filter name="filter_type_gravier" string="Gravier"
                        domain="[('type_matiere', '=', 'gravier')]"/>
                <filter name="filter_type_adjuvant" string="Adjuvant"
                        domain="[('type_matiere', '=', 'adjuvant')]"/>
                <filter name="filter_type_eau" string="Eau"
                        domain="[('type_matiere', '=', 'eau')]"/>
                <separator/>
                <filter name="filter_statut_actif" string="Matière active"
                        domain="[('statut_matiere', '=', 'actif')]"/>
                <filter name="filter_statut_indisponible" string="Matière indisponible"
                        domain="[('statut_matiere', '=', 'indisponible')]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="groupby_classification_produit" string="Classification produit"
                            context="{'group_by': 'classification_produit'}"/>
                    <filter name="groupby_type_matiere" string="Type de matière"
                            context="{'group_by': 'type_matiere'}"/>
                    <filter name="groupby_statut_matiere" string="Statut matière"
                            context="{'group_by': 'statut_matiere'}"/>
                    <filter name="groupby_emplacement" string="Emplacement"
                            context="{'group_by': 'emplacement_beton'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Activer le filtre "Sans matières premières" par défaut sur le menu Produits -->
    <record id="product.product_template_action_all" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_filter_sans_matiere_premiere': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p>
        </field>
    </record>

    <!-- Action pour matières premières béton -->
    <record id="action_beton_matieres" model="ir.actions.act_window">
        <field name="name">Matières Premières</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('classification_produit', '=', 'matiere_premiere')]</field>
        <field name="context">{'default_classification_produit': 'matiere_premiere', 'default_type': 'product'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer votre première matière première
            </p>
        </field>
    </record>
</odoo>
